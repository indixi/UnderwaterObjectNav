<?xml version="1.0"?>
<package format="2">
  <name>objectnav</name>
  <version>0.1.0</version>
  <description>Online underwater ObjectNav using frozen GFL perception and a behavior-cloning policy.</description>

  <maintainer email="root@todo.todo">Aquaflow</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>robot_control</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>aquaflow_stonefish</exec_depend>
</package>
